{
  "manifest_version": 3,
  "name": "Smart Link Copy",
  "version": "0.1.0",
  "description": "SharePoint/OneDriveのファイル・フォルダーを右クリックし、フォルダー階層付きのリンクをコピーする拡張機能",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.sharepoint.com/*", "*://onedrive.live.com/*"],
      "js": ["content/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["*://*.sharepoint.com/*", "*://onedrive.live.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["content/*.js", "shared/*.js"],
      "matches": ["*://*.sharepoint.com/*", "*://onedrive.live.com/*"]
    }
  ]
}
